GEOFLOW_NGINX_BIN=/www/server/nginx/sbin/nginx
GEOFLOW_NGINX_CONF=/www/server/nginx/conf/nginx.conf
GEOFLOW_CUSTOM_DOMAIN_SOCKET=/run/geoflow-domain-deployer/deployer.sock
GEOFLOW_CUSTOM_DOMAIN_CONFIG_DIR=/www/server/nginx/conf/geoflow-customer-sites
GEOFLOW_CUSTOM_DOMAIN_CERT_DIR=/www/server/nginx/conf/geoflow-customer-certs
GEOFLOW_CUSTOM_DOMAIN_BACKEND=http://127.0.0.1:18080
