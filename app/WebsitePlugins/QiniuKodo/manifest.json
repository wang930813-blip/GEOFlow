{
    "id": "qiniu-kodo",
    "name": "七牛云 Kodo",
    "version": "1.0.0",
    "api_version": 1,
    "type": "cloud-storage",
    "description": "将官网图片上传到七牛云对象存储。需配置已绑定存储空间的 HTTPS 访问域名。",
    "fields": {
        "region": {
            "label": "存储区域",
            "type": "select",
            "hint": "选择存储空间创建时使用的区域",
            "required": true,
            "options": {
                "z0": "华东",
                "z1": "华北",
                "z2": "华南",
                "na0": "北美",
                "as0": "东南亚",
                "cn-east-2": "华东二"
            }
        },
        "bucket": {"label": "存储空间名称", "type": "text", "required": true},
        "access_key": {"label": "AccessKey", "type": "password", "required": true, "secret": true},
        "secret_key": {"label": "SecretKey", "type": "password", "required": true, "secret": true},
        "public_url": {"label": "公开访问地址", "type": "url", "hint": "已绑定存储空间的 HTTPS 域名", "required": true}
    }
}
