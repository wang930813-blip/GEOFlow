{
    "id": "aliyun-oss",
    "name": "阿里云 OSS",
    "version": "1.0.0",
    "api_version": 1,
    "type": "cloud-storage",
    "description": "将官网图片上传到阿里云对象存储。存储桶需允许通过公开域名读取图片。",
    "fields": {
        "region": {"label": "地域标识", "type": "text", "hint": "例如 cn-hangzhou", "required": true},
        "bucket": {"label": "Bucket 名称", "type": "text", "required": true},
        "access_key_id": {"label": "AccessKey ID", "type": "password", "required": true, "secret": true},
        "access_key_secret": {"label": "AccessKey Secret", "type": "password", "required": true, "secret": true},
        "public_url": {"label": "公开访问地址", "type": "url", "hint": "HTTPS 地址，可填写已绑定存储桶的加速域名", "required": true}
    }
}
