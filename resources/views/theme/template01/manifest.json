{
    "id": "template01",
    "name": "中性企业官网模板 001",
    "version": "1.1.0",
    "description": "采用深色科技视觉、非对称版式和克制动效的企业官网模板，包含首页、关于、产品服务、资讯、文章详情与联系页面。",
    "framework": "laravel",
    "geoflow_contract": "site-theme-view-resolver",
    "data_contract": "common_site_data",
    "data_contract_version": "1.0.0",
    "mode": "full_theme",
    "requires_admin_activation": true,
    "templates": [
        "layout",
        "home",
        "about",
        "products",
        "news",
        "article",
        "contact"
    ],
    "preview_routes": [
        "/",
        "/about",
        "/products",
        "/news",
        "/contact"
    ],
    "capabilities": [
        "common_site_data",
        "dynamic_articles"
    ]
}
